# Plain UTF-8 only (P-5 fix round, review F-2): an earlier UTF-16 save made git skip the .env, .env.local,
# node_modules/ and .next/ lines, so they were not ignored.

# Dependencies and build output, in any folder
node_modules/
.next/
Website/out/
*.tsbuildinfo

# Local env files are never committed (they can hold keys). The documented template stays tracked.
.env
.env.*
!.env.example

# Terraform AWS variable files hold db_password: only the *.tfvars.example templates are tracked (p5 fix 2).
terraform/aws/env/*.tfvars

# Local Netlify folder
.netlify

# Local backup copy of the site
Website_backup/

# Local commit-message scratch file
.gitcommitmsg.txt
